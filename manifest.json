{
    "manifest_version": 2,
    "name": "Odoo Debug Labubu",
    "version": "1.0",
    "description": "Fügt automatisch debug=Labubu zu Odoo URLs hinzu.",
    "browser_specific_settings": {
        "gecko": {
            "id": "odoo-debug-labubu@addon",
            "strict_min_version": "57.0"
        }
    },
    "permissions": [
        "storage"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "browser_action": {
        "default_popup": "popup.html",
        "default_title": "Odoo Debug",
        "default_icon": "unicorn-svgrepo-com-color.svg"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ]
}
